{
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "convex_disk_bicycle_v2"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "reference_time_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_time_s": {
          "type": "number"
        },
        "coordinate_frame": {
          "const": "ego_at_reference"
        },
        "horizon_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "history_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "valid_until_s": {
          "type": "number"
        }
      },
      "required": [
        "profile",
        "schema_version",
        "scene_id",
        "revision",
        "reference_time_id",
        "reference_time_s",
        "coordinate_frame",
        "horizon_s",
        "step_s",
        "history_s",
        "valid_until_s"
      ],
      "additionalProperties": false
    },
    "scene_digest": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_s": {
            "type": "number",
            "minimum": 0
          },
          "rear_x_m": {
            "type": "number"
          },
          "rear_y_m": {
            "type": "number"
          },
          "x_m": {
            "type": "number"
          },
          "y_m": {
            "type": "number"
          },
          "yaw_rad": {
            "type": "number"
          },
          "speed_mps": {
            "type": "number"
          },
          "acceleration_mps2": {
            "type": "number"
          },
          "steer_rad": {
            "type": "number"
          },
          "curvature_per_m": {
            "type": "number"
          }
        },
        "required": [
          "time_s",
          "rear_x_m",
          "rear_y_m",
          "x_m",
          "y_m",
          "yaw_rad",
          "speed_mps",
          "acceleration_mps2",
          "steer_rad",
          "curvature_per_m"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "interpolation": {
      "const": "exact_constant_acceleration_constant_rear_curvature"
    },
    "requested_prefix_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "solver": {
      "type": "object",
      "required": [
        "name",
        "version",
        "status",
        "objective"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "number"
        }
      }
    },
    "planner_profile": {
      "const": "yaw_bounded_box_v1"
    },
    "verification_profile": {
      "const": "continuous_oriented_body_v1"
    },
    "search_profile": {
      "const": "bounded_seed_candidates_v1"
    },
    "heading_bands_rad": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -0.35,
          "maximum": 0.35
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    }
  },
  "required": [
    "metadata",
    "scene_digest",
    "points",
    "interpolation",
    "requested_prefix_s",
    "solver",
    "planner_profile",
    "verification_profile",
    "search_profile",
    "heading_bands_rad"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://driving-v1.local/schemas/trajectory_seed_candidates_v1.schema.json"
}
