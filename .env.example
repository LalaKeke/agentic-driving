# Export these variables in your shell; no automatic dotenv loading.
# http = API-key billing; codex_cli = official CLI using existing ChatGPT login.
DRIVING_BACKEND=http
# 2.0.0 retains original output; 2.1.0 explicitly permits unknown occupancy=null.
DRIVING_OUTPUT_CONTRACT=2.0.0
# For membership set DRIVING_BACKEND=codex_cli and DRIVING_MODEL=gpt-6.1-sol.
# Leave DRIVING_CODEX_BIN unset to prefer the project-local pinned CLI.
# DRIVING_CODEX_BIN=/absolute/path/to/codex
DRIVING_CODEX_TIMEOUT_S=180
# Optional child-process route for the ChatGPT CLI; normal shell proxies remain
# unchanged when unset. Explicit routing unifies proxy casing and removes the
# child's NO_PROXY/no_proxy. Credentials in proxy URLs are not supported.
# DRIVING_PROXY_URL=http://127.0.0.1:17891
# Optional existing trusted PEM bundle; certificate verification stays enabled.
# DRIVING_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
DRIVING_API_BASE=https://api.openai.com/v1
DRIVING_MODEL=replace-with-a-vision-capable-model-you-can-access
DRIVING_API_KEY=
# Official Responses route for run_local_prototype.py --backend openai_api.
# Alternatively read a private, one-line key file; never commit its contents.
# DRIVING_API_KEY_FILE=/absolute/path/to/private-api-key
# This explicit route has zero transport retries and validates the original
# business Schema after native output. It ignores legacy DRIVING_RETRIES.
# Explicit service capability selection: json_schema | json_object | prompt_json
DRIVING_OUTPUT_MODE=json_schema
DRIVING_TIMEOUT_S=90
DRIVING_RETRIES=2
# No temperature or token-limit parameter is assumed portable across models.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
# Explicit process recovery experiment (do not mix with old prompt results):
# DRIVING_OUTPUT_CONTRACT=2.1.0
# DRIVING_PROMPT_VERSION=driving_v2_2
# DRIVING_CORRIDOR_POLICY=moving_seed
